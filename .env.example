# SentinelAI Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# AI Provider (leave blank for mock fallback)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Model selection: "openai" | "claude" | "mock"
AI_PROVIDER=mock
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///./sentinelai.db

# ============================================
# Backend
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ============================================
# Frontend
# ============================================
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live-alerts
